{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crusec-bodega",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crusec-bodega",
      "database_id": "18c68cb5-6633-4891-86fb-546337d83f51",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "CATALOG_MODE": "relbase",
    "RELBASE_BASE_URL": "https://api.relbase.cl",
    "RELBASE_PRODUCTS_URL": "https://api.relbase.cl/api/v2/productos",
    "RELBASE_SCOPES": "products:read inventory:read warehouses:read",
    "RELBASE_MAIN_WAREHOUSE_ID": "2881",
    "REQUIRE_APP_ACCESS": "false",
    "SYNC_INTERVAL_MINUTES": "15"
  },
  "secrets": {
    "required": [
      "RELBASE_CLIENT_ID",
      "RELBASE_CLIENT_SECRET",
      "RELBASE_REDIRECT_URI",
      "ADMIN_PIN",
      "DATA_ENCRYPTION_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
