{
  "name": "kordis-wms",
  "version": "1.0.0",
  "private": true,
  "description": "KORDIS Warehouse Management System · Railway + Relbase OAuth",
  "scripts": {
    "start": "node server.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply crusec-bodega --local",
    "cf:migrate:remote": "wrangler d1 migrations apply crusec-bodega --remote",
    "check": "node --check server.js && node --check public/app.js && node --check src/relbase.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "wrangler": "^4.46.0"
  }
}
